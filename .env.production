# ── Django Production Configuration ──────────────────────────────────────────
DEBUG=False

# IMPORTANT: Generate a new strong key for production!
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

# Domain + localhost for SSH access
ALLOWED_HOSTS=eee.firebaseit.com,localhost,127.0.0.1

# ── Database (MySQL on Hostinger VPS) ─────────────────────────────────────────
# Uncomment and fill in after creating MySQL DB on VPS:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=ewportal_db
# DB_USER=ewportal_user
# DB_PASSWORD=your_db_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ── Security ──────────────────────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://eee.firebaseit.com
